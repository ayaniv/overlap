{
  "manifest_version": 3,
  "name": "Overlap Clock",
  "version": "1.0.0",
  "description": "World Clock at a Glance — see every city's working hours in one dial, from your toolbar.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Overlap Clock",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "host_permissions": ["https://*.i.posthog.com/*"]
}
